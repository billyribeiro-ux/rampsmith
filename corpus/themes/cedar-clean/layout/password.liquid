<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ shop.name }}</title>
    {{ 'cedar.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="password">
    <div class="password__wrapper">
      <main id="MainContent">
        {{ content_for_layout }}
      </main>
      <p class="password__admin">
        <a href="/admin" class="password__admin-link">{{ 'general.password_page.admin_link' | t }}</a>
      </p>
    </div>
  </body>
</html>
