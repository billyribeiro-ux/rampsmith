<section class="video-section">
  <h2 class="video-section__heading">{{ section.settings.heading | escape }}</h2>
  <div class="video-section__frame">
    <iframe
      title="{{ section.settings.heading | escape }}"
      src="{{ section.settings.video_url }}"
      width="640"
      height="360"
      loading="lazy"
      allow="autoplay; encrypted-media"
      allowfullscreen
    ></iframe>
  </div>
</section>

{% schema %}
{
  "name": "Video",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "video_url", "label": "Embed URL" }
  ]
}
{% endschema %}
