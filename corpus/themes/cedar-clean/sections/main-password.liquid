<div class="password__content">
  <h1 class="password__brand">{{ shop.name }}</h1>
  <p class="password__message">{{ section.settings.message | escape }}</p>
  {%- form 'storefront_password', class: 'password__form' -%}
    <input
      type="password"
      name="password"
      id="Password"
      autocomplete="current-password"
      placeholder="{{ 'general.password_page.placeholder' | t }}"
    >
    <button type="submit" class="button">{{ 'general.password_page.enter' | t }}</button>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "text", "id": "message", "label": "Message", "default": "Opening soon. Leave the light on." }
  ]
}
{% endschema %}
