<div class="slide" {{ block.shopify_attributes }}>
  <h2 class="slide__heading">{{ block.settings.heading | escape }}</h2>
  <p class="slide__text">{{ block.settings.text | escape }}</p>
</div>

{% schema %}
{
  "name": "Slide",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "text", "label": "Text" }
  ]
}
{% endschema %}
