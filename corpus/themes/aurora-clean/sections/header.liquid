<header class="header page-width">
  <button class="header__menu-toggle" type="button" aria-controls="HeaderMenu" aria-expanded="false" aria-label="{{ 'sections.header.menu' | t }}">
    {% render 'icon-hamburger' %}
  </button>

  <a href="{{ routes.root_url }}" class="header__heading-link">
    {%- if section.settings.logo != blank -%}
      {{ section.settings.logo | image_url: width: 240 | image_tag: class: 'header__logo', alt: shop.name }}
    {%- else -%}
      <span class="h2">{{ shop.name }}</span>
    {%- endif -%}
  </a>

  <nav class="header__inline-menu" id="HeaderMenu" aria-label="{{ 'sections.header.menu' | t }}">
    <ul class="list-menu" role="list">
      {%- for link in section.settings.menu.links -%}
        <li>
          <a href="{{ link.url }}" class="header__menu-item">{{ link.title | escape }}</a>
        </li>
      {%- endfor -%}
    </ul>
  </nav>

  <div class="header__icons">
    <a href="{{ routes.account_login_url }}" class="header__icon header__icon--account">
      <svg aria-hidden="true" focusable="false" class="icon icon-account" viewBox="0 0 20 20" width="20" height="20">
        <circle cx="10" cy="6" r="4" fill="none" stroke="currentColor" stroke-width="1.5"/>
        <path d="M2 19c0-4.4 3.6-7 8-7s8 2.6 8 7" fill="none" stroke="currentColor" stroke-width="1.5"/>
      </svg>
      <span class="visually-hidden">{{ 'customer.account_fallback' | t }}</span>
    </a>

    <a href="{{ routes.cart_url }}" class="header__icon header__icon--cart" id="cart-icon-bubble">
      {%- render 'icon-cart' -%}
      {%- if cart.item_count > 0 -%}
        <span class="cart-count-bubble" aria-hidden="true">{{ cart.item_count }}</span>
      {%- endif -%}
      <span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
    </a>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" }
  ]
}
{% endschema %}
