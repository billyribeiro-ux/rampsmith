{%- liquid
  assign slide_count = section.blocks.size
-%}
<div class="carousel" data-slides="{{ slide_count }}">
  <div class="carousel__track">
    {% content_for 'blocks' %}
  </div>
  <div class="carousel__dots">
    {%- for block in section.blocks -%}
      <button type="button" class="carousel__dot" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}">
        <span class="visually-hidden">{{ 'sections.carousel.slide' | t: number: forloop.index }}</span>
      </button>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Carousel",
  "blocks": [{ "type": "slide" }],
  "settings": []
}
{% endschema %}
