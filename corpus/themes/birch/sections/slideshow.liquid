<div class="slideshow" data-autoplay="false">
	<div class="slideshow__slides">
    {% for block in section.blocks %}
			<div class="slideshow__slide" {{ block.shopify_attributes }}>
				<h2 class="slideshow__title">{{ block.settings.title | escape }}</h2>
				<p class="slideshow__text">{{ block.settings.text | escape }}</p>
			</div>
    {% endfor %}
	</div>
	<div class="slideshow__controls">
		<button type='button' class='slideshow__btn slideshow__btn--prev'>
			<span class="icon icon-arrow-left" aria-hidden="true"></span>
		</button>
		<button type='button' class='slideshow__btn slideshow__btn--next'>
			<span class="icon icon-arrow-right" aria-hidden="true"></span>
		</button>
	</div>
</div>

{% schema %}
{
  "name": "Slideshow",
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "text", "label": "Text" }
      ]
    }
  ]
}
{% endschema %}
