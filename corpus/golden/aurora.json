      "criteria": ["3.1.1"],
      "category": "document-language",
      "description": "The layout's <html> element has no lang attribute, so screen readers guess the page language.",
      "occurrences": [
        {
          "page": "*",
          "selector": "html"
        }
      ],
      "mapping": "deterministic",
      "span": {
        "kind": "element",
        "file": "layout/theme.liquid",
        "start": 16,
        "tag": "html",
        "anchor": "<html class=\"no-js\">"
      },
      "expectedFix": {
        "channel": "theme-patch",
        "recipe": "document-language",
        "outcome": "fixed",
        "targeted": true
      }
    },
