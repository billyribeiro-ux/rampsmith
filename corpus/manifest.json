{
  "$schema": "./schema/manifest.schema.json",
  "version": 1,
  "renderer": {
    "liquidjs": "10.30.0"
  },
  "checker": {
    "axeCore": "4.14.0",
    "playwrightCore": "1.64.1",
    "tags": ["wcag2a", "wcag2aa", "wcag21a", "wcag21aa", "wcag22aa"],
    "viewport": {
      "width": 1280,
      "height": 800
    }
  },
  "stores": [
    {
      "name": "harbor",
      "fixtures": "fixtures/store.json",
      "golden": "golden/store-harbor.json",
      "description": "Harbor & Pine, the store the failing themes render: its product media, rich text and article bodies carry the data-audit failures."
    },
    {
      "name": "harbor-clean",
      "fixtures": "fixtures/store-clean.json",
      "golden": "golden/store-harbor-clean.json",
      "description": "The same store with every data-audit failure fixed, rendered by the controls so a clean theme shows zero findings."
    }
  ],
  "themes": [
    {
      "name": "aurora",
      "kind": "failing",
      "path": "themes/aurora",
      "store": "harbor",
      "golden": "golden/aurora.json",
      "description": "An Online Store 2.0 apparel theme in the conventions most current themes follow: JSON templates for all eight R1 page types, header and footer section groups, colour settings, and snippets for icons, cards, prices and quantity.",
      "variety": [
        "two-space indentation, one attribute per line on long tags",
        "header and footer section groups",
        "icons from {% render 'icon-*' %} snippets and one inline <svg>",
        "colour from global settings and from a section setting in a JSON template",
        "image_url | image_tag output inside a link"
      ],
      "pages": [
        {
          "id": "index",
          "template": "index",
          "path": "/"
        },
        {
          "id": "product",
          "template": "product",
          "path": "/products/linen-shirt",
          "resource": {
            "type": "product",
            "handle": "linen-shirt"
          }
        },
        {
          "id": "collection",
          "template": "collection",
          "path": "/collections/summer-edit",
          "resource": {
            "type": "collection",
            "handle": "summer-edit"
          }
        },
        {
          "id": "cart",
          "template": "cart",
          "path": "/cart"
        },
        {
          "id": "search",
          "template": "search",
          "path": "/search?q=linen"
        },
        {
          "id": "page",
          "template": "page",
          "path": "/pages/about",
          "resource": {
            "type": "page",
            "handle": "about"
          }
        },
        {
          "id": "article",
          "template": "article",
          "path": "/blogs/journal/caring-for-linen",
          "resource": {
            "type": "article",
            "handle": "journal/caring-for-linen"
          }
        },
        {
          "id": "login",
          "template": "customers/login",
          "path": "/account/login"
        }
      ]
    },
    {
      "name": "birch",
      "kind": "failing",
      "path": "themes/birch",
      "store": "harbor",
      "golden": "golden/birch.json",
      "description": "An older-style theme still common on live stores: tab indentation, CRLF snippets, static header and footer sections, {% include %}, a stylesheet rendered from theme settings (theme.css.liquid), icon fonts, unquoted and single-quoted attributes, and markup duplicated for mobile and desktop.",
      "variety": [
        "tab indentation",
        "CRLF line endings in snippets",
        "static sections with settings in config/settings_data.json",
        "{% include %} and legacy img_url",
        "colour from assets/theme.css.liquid, both hard-coded and from settings",
        "unquoted and single-quoted attribute values",
        "lazy images with data-src",
        "an empty aria-label",
        "identical mobile and desktop markup in one section"
      ],
      "pages": [
        {
          "id": "index",
          "template": "index",
          "path": "/"
        },
        {
          "id": "collection",
          "template": "collection",
          "path": "/collections/summer-edit",
          "resource": {
            "type": "collection",
            "handle": "summer-edit"
          }
        },
        {
          "id": "product",
          "template": "product",
          "path": "/products/wool-throw",
          "resource": {
            "type": "product",
            "handle": "wool-throw"
          }
        },
        {
          "id": "search",
          "template": "search",
          "path": "/search?q=linen"
        },
        {
          "id": "contact",
          "template": "page.contact",
          "path": "/pages/contact",
          "resource": {
            "type": "page",
            "handle": "contact"
          }
        }
      ]
    },
    {
      "name": "cedar",
      "kind": "failing",
      "path": "themes/cedar",
      "store": "harbor",
      "golden": "golden/cedar.json",
      "description": "A current theme built on theme blocks: sections that render {% content_for 'blocks' %}, blocks in blocks/ with their own schema, {% stylesheet %} in sections, {% liquid %}, a password layout, and the custom widgets (carousel dots, listbox variant picker, accordion) where hand-written ARIA goes wrong.",
      "variety": [
        "theme blocks rendered with {% content_for 'blocks' %}",
        "{% stylesheet %} inside a section",
        "icons inlined with inline_asset_content",
        "srcset images in a block",
        "a password layout with no landmarks",
        "custom widgets with misused ARIA roles and states",
        "an embedded video iframe",
        "pagination with small targets"
      ],
      "pages": [
        {
          "id": "index",
          "template": "index",
          "path": "/"
        },
        {
          "id": "product",
          "template": "product",
          "path": "/products/linen-shirt",
          "resource": {
            "type": "product",
            "handle": "linen-shirt"
          }
        },
        {
          "id": "collection",
          "template": "collection",
          "path": "/collections/summer-edit",
          "resource": {
            "type": "collection",
            "handle": "summer-edit"
          }
        },
        {
          "id": "password",
          "template": "password",
          "path": "/password"
        }
      ]
    },
    {
      "name": "aurora-clean",
      "kind": "control",
      "path": "themes/aurora-clean",
      "store": "harbor-clean",
      "golden": "golden/aurora-clean.json",
      "description": "Aurora with every golden finding fixed the way the recipes write their edits (lang, labels, visually hidden text, aria-label, alt from the image object) and passing colours; with the clean store it must produce zero results.",
      "twinOf": "aurora",
      "variety": ["the markup of its twin with each finding fixed"],
      "pages": [
        {
          "id": "index",
          "template": "index",
          "path": "/"
        },
        {
          "id": "product",
          "template": "product",
          "path": "/products/linen-shirt",
          "resource": {
            "type": "product",
            "handle": "linen-shirt"
          }
        },
        {
          "id": "collection",
          "template": "collection",
          "path": "/collections/summer-edit",
          "resource": {
            "type": "collection",
            "handle": "summer-edit"
          }
        },
        {
          "id": "cart",
          "template": "cart",
          "path": "/cart"
        },
        {
          "id": "search",
          "template": "search",
          "path": "/search?q=linen"
        },
        {
          "id": "page",
          "template": "page",
          "path": "/pages/about",
          "resource": {
            "type": "page",
            "handle": "about"
          }
        },
        {
          "id": "article",
          "template": "article",
          "path": "/blogs/journal/caring-for-linen",
          "resource": {
            "type": "article",
            "handle": "journal/caring-for-linen"
          }
        },
        {
          "id": "login",
          "template": "customers/login",
          "path": "/account/login"
        }
      ]
    },
    {
      "name": "birch-clean",
      "kind": "control",
      "path": "themes/birch-clean",
      "store": "harbor-clean",
      "golden": "golden/birch-clean.json",
      "description": "Birch with every golden finding fixed in its own style (tabs, CRLF snippets, the sr-only class, a :focus-visible outline); with the clean store it must produce zero results.",
      "twinOf": "birch",
      "variety": ["the markup of its twin with each finding fixed"],
      "pages": [
        {
          "id": "index",
          "template": "index",
          "path": "/"
        },
        {
          "id": "collection",
          "template": "collection",
          "path": "/collections/summer-edit",
          "resource": {
            "type": "collection",
            "handle": "summer-edit"
          }
        },
        {
          "id": "product",
          "template": "product",
          "path": "/products/wool-throw",
          "resource": {
            "type": "product",
            "handle": "wool-throw"
          }
        },
        {
          "id": "search",
          "template": "search",
          "path": "/search?q=linen"
        },
        {
          "id": "contact",
          "template": "page.contact",
          "path": "/pages/contact",
          "resource": {
            "type": "page",
            "handle": "contact"
          }
        }
      ]
    },
    {
      "name": "cedar-clean",
      "kind": "control",
      "path": "themes/cedar-clean",
      "store": "harbor-clean",
      "golden": "golden/cedar-clean.json",
      "description": "Cedar with every golden finding fixed, including the custom widgets (option roles, a valid aria-expanded, plain buttons for carousel dots) and a main landmark on the password page; with the clean store it must produce zero results.",
      "twinOf": "cedar",
      "variety": ["the markup of its twin with each finding fixed"],
      "pages": [
        {
          "id": "index",
          "template": "index",
          "path": "/"
        },
        {
          "id": "product",
          "template": "product",
          "path": "/products/linen-shirt",
          "resource": {
            "type": "product",
            "handle": "linen-shirt"
          }
        },
        {
          "id": "collection",
          "template": "collection",
          "path": "/collections/summer-edit",
          "resource": {
            "type": "collection",
            "handle": "summer-edit"
          }
        },
        {
          "id": "password",
          "template": "password",
          "path": "/password"
        }
      ]
    }
  ]
}
