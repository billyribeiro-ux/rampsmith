{
  "name": "@rampsmith/corpus-tools",
  "version": "0.0.0",
  "private": true,
  "description": "Checks for the theme test corpus (PLAN §23): golden files validate, spans exist, rule ids are known, and each theme page rendered statically and checked by axe-core in Chromium fires exactly its golden findings.",
  "type": "module",
  "engines": {
    "node": ">=26.12.0 <27"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "node scripts/ensure-chromium.ts && vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "corpus": "node src/cli.ts"
  },
  "dependencies": {
    "@rampsmith/liquid-patch": "workspace:*",
    "@shopify/liquid-html-parser": "2.10.2",
    "ajv": "8.20.0",
    "axe-core": "4.14.0",
    "jsonc-parser": "3.3.1",
    "liquidjs": "10.30.0",
    "playwright-core": "1.64.1"
  },
  "devDependencies": {
    "@rampsmith/tsconfig": "workspace:*",
    "vitest": "5.0.5"
  }
}
