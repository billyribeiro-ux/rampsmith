    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@rampsmith/tsconfig": "workspace:*",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@opentelemetry/api": "1.9.1",
    "@rampsmith/claims-lint": "workspace:*",
    "ajv": "8.20.0",
    "parse5": "8.0.1"
  }
}
