{
  "name": "@rampsmith/ai",
  "version": "0.0.0",
  "private": true,
  "description": "Rampsmith's AI subsystem (PLAN §13): model routing, prompts, structured outputs, cost and budgets, data handling and the evaluation harness. The engine's ai worker calls it.",
  "type": "module",
  "engines": {
    "node": ">=26.12.0 <27"
  },
