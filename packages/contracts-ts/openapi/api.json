{
  "openapi": "3.1.0",
  "info": {
    "title": "Rampsmith API",
    "description": "Control-plane API behind the Rampsmith web app. Errors are RFC 9457 problem+json.",
    "license": {
      "name": "Proprietary"
    },
    "version": "0.0.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "operations"
        ],
        "summary": "Liveness: answers as long as the process runs. Never touches dependencies, so a slow\ndatabase cannot get a healthy process restarted.",
        "operationId": "healthz",
        "responses": {
          "200": {
            "description": "The process is up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "operations"
        ],
        "summary": "Readiness: the database answers and holds at least this build's newest migration.",
        "operationId": "readyz",
        "responses": {
          "200": {
            "description": "Ready to serve",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "503": {
            "description": "Not ready",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/register/finish": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Completes a registration and signs the new user in.",
        "operationId": "finishRegistration",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CeremonyResponse"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionCreated"
                }
              }
            }
          },
          "400": {
            "description": "The passkey did not verify",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "The email was taken meanwhile",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/register/start": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Starts registering an account and its first passkey.",
        "operationId": "startRegistration",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistrationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CeremonyStarted"
                }
              }
            }
          },
          "409": {
            "description": "The email is taken",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/session": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "The signed-in user; also extends the session's idle expiry.",
        "operationId": "getSession",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionInfo"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "dashboard_session": []
          }
        ]
      },
      "delete": {
        "tags": [
          "auth"
        ],
        "summary": "Signs out: the session token stops working.",
        "operationId": "deleteSession",
        "responses": {
          "204": {
            "description": "Signed out"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "dashboard_session": []
          }
        ]
      }
    },
    "/v1/auth/sign-in/finish": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Completes a passkey sign-in.",
        "operationId": "finishSignIn",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CeremonyResponse"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionCreated"
                }
              }
            }
          },
          "400": {
            "description": "The passkey did not verify",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/sign-in/start": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Starts a passkey sign-in. No email: the browser offers the passkeys it holds for this site.",
        "operationId": "startSignIn",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CeremonyStarted"
                }
              }
            }
          }
        }
      }
    },
    "/v1/shopify/session": {
      "post": {
        "tags": [
          "shopify"
        ],
        "summary": "Starts an embedded-app session: verifies the Shopify session token and, on first use,\ninstalls the app by token exchange.",
        "operationId": "createShopifySession",
        "responses": {
          "200": {
            "description": "Authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionInfo"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or stale session token; the response carries `X-Shopify-Retry-Invalid-Session-Request: 1`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "502": {
            "description": "Shopify did not answer token exchange",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Shopify authentication is not configured",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "shopify_session": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CeremonyResponse": {
        "type": "object",
        "description": "Completes a ceremony with the browser's answer.",
        "required": [
          "ceremony_id",
          "credential"
        ],
        "properties": {
          "ceremony_id": {
            "type": "string",
            "format": "uuid",
            "description": "From the matching `start` call."
          },
          "credential": {
            "type": "object",
            "description": "`PublicKeyCredential.toJSON()` from the browser."
          }
        },
        "additionalProperties": false
      },
      "CeremonyStarted": {
        "type": "object",
        "description": "Options for `navigator.credentials`, and the ceremony they belong to.",
        "required": [
          "ceremony_id",
          "options"
        ],
        "properties": {
          "ceremony_id": {
            "type": "string",
            "format": "uuid",
            "description": "Echo this in the matching `finish` call."
          },
          "options": {
            "type": "object",
            "description": "WebAuthn options in their JSON form (`publicKey` and, for sign-in, `mediation`)."
          }
        }
      },
      "FieldError": {
        "type": "object",
        "description": "One invalid field of a request.",
        "required": [
          "field",
          "message"
        ],
        "properties": {
          "field": {
            "type": "string",
            "description": "JSON path of the field, such as `shop` or `items.0.alt`."
          },
          "message": {
            "type": "string",
            "description": "What is wrong, safe to show to the user."
          }
        }
      },
      "Health": {
        "type": "object",
        "description": "The process is up.",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "Always `ok`."
          }
        }
      },
      "Problem": {
        "type": "object",
        "description": "An RFC 9457 `application/problem+json` body with Rampsmith's extension members.\n\nUnknown members are ignored on input, as RFC 9457 requires of consumers.",
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ProblemCode",
            "description": "Stable machine-readable code."
          },
          "detail": {
            "type": [
              "string",
              "null"
            ],
            "description": "Explanation specific to this occurrence. Never contains tokens or personal data."
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "description": "Field-level errors when `code` is `validation_failed`."
          },
          "instance": {
            "type": [
              "string",
              "null"
            ],
            "description": "URI reference identifying this occurrence."
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "The HTTP status code.",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "description": "Short summary of the problem type."
          },
          "trace_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "W3C trace id of the request, for support."
          },
          "type": {
            "type": "string",
            "description": "URI reference identifying the problem type: `/problems/<code>`."
          }
        }
      },
      "ProblemCode": {
        "type": "string",
        "description": "Stable, enumerated error code. Clients branch on this, never on `title` or `detail`.\n\nAdding a code is a contract change; renaming or removing one is a breaking change.",
        "enum": [
          "bad_request",
          "validation_failed",
          "unauthenticated",
          "forbidden",
          "not_found",
          "conflict",
          "payload_too_large",
          "rate_limited",
          "internal",
          "upstream_failed",
          "unavailable"
        ]
      },
      "Readiness": {
        "type": "object",
        "description": "The process can serve: the database answers and has this build's migrations.",
        "required": [
          "status",
          "schema_version",
          "expected_schema_version"
        ],
        "properties": {
          "expected_schema_version": {
            "type": "integer",
            "format": "int64",
            "description": "The newest migration this build knows."
          },
          "schema_version": {
            "type": "integer",
            "format": "int64",
            "description": "The newest migration applied to the database."
          },
          "status": {
            "type": "string",
            "description": "Always `ready`."
          }
        }
      },
      "RegistrationRequest": {
        "type": "object",
        "description": "Starts a registration.",
        "required": [
          "email",
          "display_name"
        ],
        "properties": {
          "display_name": {
            "type": "string",
            "description": "The name to show in the dashboard."
          },
          "email": {
            "type": "string",
            "description": "The account's email address."
          }
        },
        "additionalProperties": false
      },
      "SessionCreated": {
        "type": "object",
        "description": "A new session. The token is shown once; store it in an `HttpOnly` cookie.",
        "required": [
          "token",
          "expires_at",
          "user"
        ],
        "properties": {
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the session ends regardless of use."
          },
          "token": {
            "type": "string",
            "description": "The session token."
          },
          "user": {
            "$ref": "#/components/schemas/UserInfo",
            "description": "Who signed in."
          }
        }
      },
      "SessionInfo": {
        "type": "object",
        "description": "Wraps the signed-in user.",
        "required": [
          "user"
        ],
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserInfo",
            "description": "Who is signed in."
          }
        }
      },
      "UserInfo": {
        "type": "object",
        "description": "A dashboard user, as the web app shows them.",
        "required": [
          "id",
          "email",
          "display_name"
        ],
        "properties": {
          "display_name": {
            "type": "string",
            "description": "Their display name."
          },
          "email": {
            "type": "string",
            "description": "Their email address."
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "The user's id."
          }
        }
      }
    },
    "securitySchemes": {
      "dashboard_session": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "`Session <token>`: the dashboard session token, forwarded by the web app (ADR-024)."
      },
      "shopify_session": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "The App Bridge session (ID) token, forwarded by the web app (ADR-022)."
      }
    }
  },
  "tags": [
    {
      "name": "operations",
      "description": "Liveness and readiness for the platform"
    },
    {
      "name": "shopify",
      "description": "The embedded Shopify app's session"
    },
    {
      "name": "auth",
      "description": "Standalone dashboard sign-in with passkeys"
    }
  ]
}
