{
  "name": "@rampsmith/engine",
  "version": "0.0.0",
  "private": true,
  "description": "The scanning engine (PLAN §11): Chromium through egress, axe-core, findings recorded per tenant.",
  "type": "module",
  "engines": {
    "node": ">=26.12.0 <27"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "rampsmith-engine": "./src/main.ts",
    "rampsmith-engine-self-check": "./src/self-check.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@axe-core/playwright": "4.14.0",
    "@opentelemetry/api": "1.9.1",
    "@rampsmith/a11y-rules": "workspace:*",
    "@rampsmith/ai": "workspace:*",
    "@rampsmith/contracts-ts": "workspace:*",
    "@rampsmith/queue": "workspace:*",
    "@rampsmith/telemetry": "workspace:*",
    "ajv": "8.20.0",
    "axe-core": "4.14.0",
    "playwright": "1.64.1",
    "postgres": "3.4.9",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@rampsmith/corpus-tools": "workspace:*",
    "@rampsmith/tsconfig": "workspace:*",
    "@types/node": "26.6.5",
    "vitest": "5.0.5"
  }
}
