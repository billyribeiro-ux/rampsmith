{
  "name": "@rampsmith/web",
  "version": "0.0.0",
  "private": true,
  "description": "The SvelteKit backend-for-frontend: the embedded Shopify App Home, the standalone dashboard and the marketing site (PLAN §16, ADR-005).",
  "type": "module",
  "engines": {
    "node": ">=26.12.0 <27"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "sync": "pnpm run i18n && svelte-kit sync",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "test:e2e": "vite build && node tests/e2e-db.ts && playwright test"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@rampsmith/contracts-ts": "workspace:*",
    "@rampsmith/reports": "workspace:*",
    "@rampsmith/telemetry": "workspace:*",
    "@rampsmith/ui": "workspace:*",
    "phosphor-svelte": "3.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@inlang/paraglide-js": "2.29.0",
    "@inlang/plugin-message-format": "4.5.4",
    "@opentelemetry/context-async-hooks": "2.12.0",
    "@opentelemetry/core": "2.12.0",
    "@playwright/test": "1.64.1",
    "@rampsmith/tsconfig": "workspace:*",
    "@sveltejs/adapter-node": "6.0.0",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.5",
    "postgres": "3.4.9",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
