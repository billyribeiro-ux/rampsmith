# Copy to .env for local runs of api and ctl. Never commit .env (see .gitignore).
# Values here are placeholders; real ones live in Railway variables and a password manager.

# api connects as rampsmith_app, ctl as rampsmith_worker (both NOLOGIN in migrations: grant
# LOGIN to a per-environment user that is a member of the role).
DATABASE_URL=postgres://rampsmith_app_login:change-me@127.0.0.1:5432/rampsmith
BIND_ADDR=127.0.0.1:8080

# From the Shopify Partner dashboard (docs/runbooks/shopify-dev-store.md).
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Envelope encryption master keys, newest first: id:base64(32 bytes)[,id:base64...] (ADR-021).
# Generate one with: head -c 32 /dev/urandom | base64
RAMPSMITH_MASTER_KEYS=

# Passkeys for the standalone dashboard (ADR-024): the registrable domain and the web origin.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGIN=http://localhost:5173

# Optional: OTLP collector (traces and metrics); nothing is exported when unset (ADR-019).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# The GitHub pull-request channel (ADR-290). Off unless the flag is exactly `true`; with it on, the
# api needs the App's client id, client secret and webhook secret, and ctl needs the client id and
# the private key (the PEM, with literal \n for newlines). The api never holds the private key.
CODE_FIX_CHANNEL_ENABLED=false
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_WEBHOOK_SECRET=
# GITHUB_APP_PRIVATE_KEY=
